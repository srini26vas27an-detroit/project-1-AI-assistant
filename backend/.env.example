
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# SQLite file (ephemeral on Render free tier).
DATABASE_URL=sqlite:///./data/kirana.db
# Turso (persistent) would look like:
# DATABASE_URL=sqlite+libsql://your-db.turso.io?authToken=YOUR_TOKEN&secure=true

# Comma-separated list of allowed frontend origins (the Vite dev server runs on port 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true = fill an empty database with demo products and customers on startup
SEED_DEMO_DATA=true
